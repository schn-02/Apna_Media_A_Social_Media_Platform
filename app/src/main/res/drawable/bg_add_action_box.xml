<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <solid android:color="#2B1633" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#B83B91" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#24172E" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#452750" />
        </shape>
    </item>

</selector>