<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <layer-list>

            <item>
                <shape>
                    <corners android:radius="22dp" />
                    <solid android:color="#332A123A" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#FF4FC3" />
                </shape>
            </item>

        </layer-list>
    </item>

    <item>
        <layer-list>

            <!-- Glass base -->
            <item>
                <shape>
                    <corners android:radius="22dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="#22120819"
                        android:centerColor="#332A123A"
                        android:endColor="#22102A4A" />
                    <stroke
                        android:width="1.2dp"
                        android:color="#66FF4FC3" />
                </shape>
            </item>

            <!-- Blue-pink subtle glow -->
            <item
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="1dp">
                <shape>
                    <corners android:radius="21dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="#14FF4FC3"
                        android:centerColor="#10120819"
                        android:endColor="#223A8DFF" />
                </shape>
            </item>

            <!-- Top shine -->
            <item
                android:left="4dp"
                android:top="3dp"
                android:right="4dp"
                android:bottom="34dp">
                <shape>
                    <corners android:topLeftRadius="18dp"
                        android:topRightRadius="18dp"
                        android:bottomLeftRadius="8dp"
                        android:bottomRightRadius="8dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#33FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>

        </layer-list>
    </item>

</selector>