<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <solid android:color="#182A42" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#4D9CFF" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#101A2A" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1.2dp"
                android:color="#356FAF" />
        </shape>
    </item>

</selector>