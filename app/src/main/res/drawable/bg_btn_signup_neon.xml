<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <layer-list>

            <item>
                <shape>
                    <corners android:radius="22dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="#9D0072"
                        android:centerColor="#C6008E"
                        android:endColor="#5420C8" />
                </shape>
            </item>

            <item
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp">
                <shape>
                    <corners android:radius="20dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="#B723A0"
                        android:centerColor="#DE019C"
                        android:endColor="#6A2CFF" />
                </shape>
            </item>

        </layer-list>
    </item>

    <item>
        <layer-list>

            <!-- Outer neon border -->
            <item>
                <shape>
                    <corners android:radius="22dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="#FF4FC3"
                        android:centerColor="#7B2CFF"
                        android:endColor="#3A8DFF" />
                </shape>
            </item>

            <!-- Main button -->
            <item
                android:left="1.5dp"
                android:top="1.5dp"
                android:right="1.5dp"
                android:bottom="1.5dp">
                <shape>
                    <corners android:radius="21dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="#DE019C"
                        android:centerColor="#B723A0"
                        android:endColor="#7B2CFF" />
                </shape>
            </item>

            <!-- Glass shine -->
            <item
                android:left="4dp"
                android:top="3dp"
                android:right="4dp"
                android:bottom="32dp">
                <shape>
                    <corners
                        android:topLeftRadius="18dp"
                        android:topRightRadius="18dp"
                        android:bottomLeftRadius="8dp"
                        android:bottomRightRadius="8dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#66FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>

            <!-- Bottom depth -->
            <item
                android:left="6dp"
                android:right="6dp"
                android:top="44dp"
                android:bottom="3dp">
                <shape>
                    <corners android:radius="14dp" />
                    <solid android:color="#33000000" />
                </shape>
            </item>

        </layer-list>
    </item>

</selector>