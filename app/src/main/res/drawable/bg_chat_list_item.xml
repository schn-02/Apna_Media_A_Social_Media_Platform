<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#4A123E"
                android:centerColor="#5B1A56"
                android:endColor="#26112E" />

            <corners android:radius="22dp" />

            <stroke
                android:width="1.5dp"
                android:color="#FF4FC3" />
        </shape>
    </item>

    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#2D1235"
                android:centerColor="#401648"
                android:endColor="#1B0B24" />

            <corners android:radius="22dp" />

            <stroke
                android:width="1dp"
                android:color="#DE019C" />
        </shape>
    </item>

</selector>