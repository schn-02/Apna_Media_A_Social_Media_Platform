<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#B90083" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#DE019C"
                android:centerColor="#FF4FC3"
                android:endColor="#7B2CFF" />
            <stroke
                android:width="1dp"
                android:color="#FF8ADC" />
        </shape>
    </item>
</selector>