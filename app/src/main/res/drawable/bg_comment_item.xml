<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#2B1435"
                android:centerColor="#321438"
                android:endColor="#1B0F22" />

            <corners android:radius="22dp" />

            <stroke
                android:width="1dp"
                android:color="#DE019C" />
        </shape>
    </item>

    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#1B1326"
                android:centerColor="#21102B"
                android:endColor="#120819" />

            <corners android:radius="22dp" />

            <stroke
                android:width="1dp"
                android:color="#452750" />
        </shape>
    </item>

</selector>