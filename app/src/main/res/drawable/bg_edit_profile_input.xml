<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape>
            <solid android:color="#26122E" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1.5dp"
                android:color="#FF4FC3" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#17101E" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#4A2558" />
        </shape>
    </item>

</selector>