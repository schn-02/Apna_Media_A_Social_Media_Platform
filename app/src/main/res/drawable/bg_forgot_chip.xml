<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <solid android:color="#332A123A" />
            <corners android:radius="17dp" />
            <stroke
                android:width="1dp"
                android:color="#FF4FC3" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#221B0F22" />
            <corners android:radius="17dp" />
            <stroke
                android:width="1dp"
                android:color="#555B255D" />
        </shape>
    </item>

</selector>