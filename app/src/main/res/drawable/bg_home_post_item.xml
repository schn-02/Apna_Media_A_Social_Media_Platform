<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#3B1832"
                android:centerColor="#4A2634"
                android:endColor="#33260E" />

            <corners android:radius="24dp" />

            <stroke
                android:width="1dp"
                android:color="#FFD166" />
        </shape>
    </item>

    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#160A1F"
                android:centerColor="#261426"
                android:endColor="#2A210F" />

            <corners android:radius="24dp" />

            <stroke
                android:width="1dp"
                android:color="#C79A3A" />
        </shape>
    </item>

</selector>