<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape>
                    <corners android:radius="16dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="#B90083"
                        android:centerColor="#A722A0"
                        android:endColor="#4320B8" />
                </shape>
            </item>

            <item
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp">
                <shape>
                    <corners android:radius="15dp" />
                    <solid android:color="#22120819" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>

            <!-- soft selected glow -->
            <item>
                <shape>
                    <corners android:radius="16dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="#55FF4FC3"
                        android:centerColor="#442A123A"
                        android:endColor="#553A8DFF" />
                </shape>
            </item>

            <!-- glass body -->
            <item
                android:left="1.5dp"
                android:top="1.5dp"
                android:right="1.5dp"
                android:bottom="1.5dp">
                <shape>
                    <corners android:radius="15dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="#2A123A"
                        android:centerColor="#321633"
                        android:endColor="#1C2344" />
                    <stroke
                        android:width="1dp"
                        android:color="#88FF4FC3" />
                </shape>
            </item>

            <!-- top shine -->
            <item
                android:left="4dp"
                android:top="3dp"
                android:right="4dp"
                android:bottom="28dp">
                <shape>
                    <corners
                        android:topLeftRadius="14dp"
                        android:topRightRadius="14dp"
                        android:bottomLeftRadius="6dp"
                        android:bottomRightRadius="6dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#33FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>

            <!-- selected bottom line -->
            <item
                android:left="26dp"
                android:right="26dp"
                android:top="36dp"
                android:bottom="4dp">
                <shape>
                    <corners android:radius="4dp" />
                    <solid android:color="#FF4FC3" />
                </shape>
            </item>

        </layer-list>
    </item>

</selector>