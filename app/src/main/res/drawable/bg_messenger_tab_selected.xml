<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <corners android:radius="17dp" />
            <gradient
                android:angle="135"
                android:startColor="#B90083"
                android:centerColor="#DE019C"
                android:endColor="#5B21D6" />
            <stroke
                android:width="1.5dp"
                android:color="#FFFFFF" />
        </shape>
    </item>

    <item>
        <layer-list>

            <!-- Outer bright pink-blue glow -->
            <item>
                <shape>
                    <corners android:radius="17dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="#FF4FC3"
                        android:centerColor="#DE019C"
                        android:endColor="#3A8DFF" />
                </shape>
            </item>

            <!-- Main selected body -->
            <item
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp">
                <shape>
                    <corners android:radius="16dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="#F004A9"
                        android:centerColor="#C018B6"
                        android:endColor="#6D35FF" />
                </shape>
            </item>

            <!-- Glass shine -->
            <item
                android:left="6dp"
                android:top="4dp"
                android:right="6dp"
                android:bottom="31dp">
                <shape>
                    <corners
                        android:topLeftRadius="14dp"
                        android:topRightRadius="14dp"
                        android:bottomLeftRadius="7dp"
                        android:bottomRightRadius="7dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#66FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>

            <!-- Bottom selected glow line -->
            <item
                android:left="34dp"
                android:right="34dp"
                android:top="38dp"
                android:bottom="4dp">
                <shape>
                    <corners android:radius="5dp" />
                    <solid android:color="#FFFFFF" />
                </shape>
            </item>

        </layer-list>
    </item>

</selector>