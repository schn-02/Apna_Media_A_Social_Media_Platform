<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <corners android:radius="17dp" />
            <solid android:color="#24112C" />
            <stroke
                android:width="1.5dp"
                android:color="#AAFF4FC3" />
        </shape>
    </item>

    <item>
        <shape>
            <corners android:radius="17dp" />
            <gradient
                android:angle="135"
                android:startColor="#21102B"
                android:centerColor="#18101F"
                android:endColor="#142033" />
            <stroke
                android:width="1dp"
                android:color="#5B255D" />
        </shape>
    </item>

</selector>