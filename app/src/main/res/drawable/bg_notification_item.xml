<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#3A1238"
                android:centerColor="#4A184A"
                android:endColor="#24112C" />

            <corners android:radius="22dp" />

            <stroke
                android:width="1dp"
                android:color="#FF4FC3" />
        </shape>
    </item>

    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#27112F"
                android:centerColor="#34143D"
                android:endColor="#1A0B22" />

            <corners android:radius="22dp" />

            <stroke
                android:width="1dp"
                android:color="#B723A0" />
        </shape>
    </item>

</selector>