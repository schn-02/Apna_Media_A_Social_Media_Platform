<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#DE019C"
                android:endColor="#7B2CFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#24112C" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#DE019C" />
        </shape>
    </item>

</selector>