<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <solid android:color="#049B5B" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#18D27A"
                android:endColor="#078B55" />

            <corners android:radius="16dp" />

            <stroke
                android:width="1dp"
                android:color="#75FFD0" />
        </shape>
    </item>

</selector>