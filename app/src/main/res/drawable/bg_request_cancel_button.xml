<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <solid android:color="#B80F3E" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#FF4F7A"
                android:endColor="#C11245" />

            <corners android:radius="16dp" />

            <stroke
                android:width="1dp"
                android:color="#FFB3C7" />
        </shape>
    </item>

</selector>