<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <solid android:color="#24112C" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#DE019C" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#100817" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#452750" />
        </shape>
    </item>

</selector>