<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_social_home"
    android:fitsSystemWindows="true"
    tools:context=".Post.Post">

    <!-- Pink Glow Top -->
    <View
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_marginTop="-125dp"
        android:layout_marginEnd="-70dp"
        android:alpha="0.75"
        android:background="@drawable/bg_pink_glow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Pink Glow Left -->
    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginStart="-110dp"
        android:layout_marginTop="250dp"
        android:alpha="0.25"
        android:background="@drawable/bg_pink_glow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="Create Post"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:includeFontPadding="false"
                android:text="Preview your selected photos before posting"
                android:textColor="#FF8ADC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Music Selected Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="22dp"
                android:visibility="gone"
                app:cardBackgroundColor="#1B1326"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:strokeColor="#5B255D"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/musicAnimation"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:visibility="gone"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"
                        app:lottie_rawRes="@raw/music3" />

                    <TextView
                        android:id="@+id/MusicName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:ellipsize="marquee"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center_vertical"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:maxLines="1"
                        android:scrollHorizontally="true"
                        android:singleLine="true"
                        android:text="Music Name"
                        android:textColor="#FF8ADC"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Image Preview Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="430dp"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="#100817"
                app:cardCornerRadius="28dp"
                app:cardElevation="12dp"
                app:strokeColor="#5B255D"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.denzcoskun.imageslider.ImageSlider
                        android:id="@+id/imageSliderPost"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#08040C" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_preview_bottom_fade" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_preview_chip"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:text="Selected Photos"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Music Control Card -->
            <!-- Music Control Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="#1B1326"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:strokeColor="#5B255D"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/selectMusic"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/apna_volume_clean"
                        android:drawablePadding="12dp"
                        android:gravity="center_vertical"
                        android:text="Select Music"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/stopMusic"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="10dp"
                        android:background="@null"
                        android:contentDescription="Stop music"
                        android:padding="5dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/apna_stop_clean"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/musicPlay"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@null"
                        android:contentDescription="Play music"
                        android:padding="5dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/apna_play_clean"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>
            <!-- Caption Box -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="#1B1326"
                app:cardCornerRadius="22dp"
                app:cardElevation="8dp"
                app:strokeColor="#5B255D"
                app:strokeWidth="1dp">

                <EditText
                    android:id="@+id/Caption"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:gravity="top|start"
                    android:hint="Write a caption..."
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="5"
                    android:minLines="2"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#A98FB3"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Post Button -->
            <Button
                android:id="@+id/Post"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_post_button_pink"
                android:stateListAnimator="@null"
                android:text="Post Now"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>