<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:layout_marginStart="4dp"
    android:layout_marginTop="5dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="5dp"
    app:cardBackgroundColor="#1B1326"
    app:cardCornerRadius="22dp"
    app:cardElevation="6dp"
    app:strokeColor="#452750"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_chat_list_item"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- Profile Ring -->
        <FrameLayout
            android:id="@+id/profileImageRing"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:background="@drawable/bg_chat_profile_ring"
            android:padding="3dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ChatSelectionProfileImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/userstory"
                app:shapeAppearanceOverlay="@style/CircleImageShape"
                tools:src="@drawable/userstory" />

        </FrameLayout>

        <!-- Profile Name -->
        <TextView
            android:id="@+id/ChatSelectionProfileName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Profile Name"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/ChatSelectionLastMessage"
            app:layout_constraintEnd_toStartOf="@id/chatStatusDot"
            app:layout_constraintStart_toEndOf="@id/profileImageRing"
            app:layout_constraintTop_toTopOf="@id/profileImageRing"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Sachin Rawat" />

        <!-- Last Message -->
        <TextView
            android:id="@+id/ChatSelectionLastMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Last Message"
            android:textColor="#A98FB3"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/profileImageRing"
            app:layout_constraintEnd_toStartOf="@id/chatStatusDot"
            app:layout_constraintStart_toEndOf="@id/profileImageRing"
            app:layout_constraintTop_toBottomOf="@id/ChatSelectionProfileName"
            tools:text="Hey, how are you?" />

        <!-- Small Online / Chat Dot -->
        <View
            android:id="@+id/chatStatusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_chat_status_dot"
            app:layout_constraintBottom_toBottomOf="@id/profileImageRing"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/profileImageRing" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>