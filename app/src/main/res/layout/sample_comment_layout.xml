<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="#1B1326"
    app:cardCornerRadius="22dp"
    app:cardElevation="5dp"
    app:strokeColor="#452750"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_comment_item"
        android:minHeight="86dp"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/commentProfileImage"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="#24112C"
            android:padding="2dp"
            android:scaleType="centerCrop"
            android:src="@drawable/userstory"
            app:shapeAppearanceOverlay="@style/CircleImageShape"
            app:strokeColor="#FF4FC3"
            app:strokeWidth="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/userstory" />

        <TextView
            android:id="@+id/commentProfileName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Profile Name"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/commentProfileImage"
            app:layout_constraintTop_toTopOf="@id/commentProfileImage"
            tools:text="Sachin Rawat" />

        <TextView
            android:id="@+id/CommentMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="7dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:lineSpacingExtra="3dp"
            android:maxLines="4"
            android:text="Last Message"
            android:textColor="#D8C8E0"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/commentProfileImage"
            app:layout_constraintTop_toBottomOf="@id/commentProfileName"
            tools:text="Nice post bro, this looks really good 🔥" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>