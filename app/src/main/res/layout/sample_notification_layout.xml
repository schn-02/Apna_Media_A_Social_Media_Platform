<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="#1B1326"
    app:cardCornerRadius="22dp"
    app:cardElevation="6dp"
    app:strokeColor="#B723A0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_notification_item"
        android:gravity="center_vertical"
        android:minHeight="96dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <!-- Left: Your liked post image -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/notificationPostPic"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="#100817"
            android:padding="2dp"
            android:scaleType="centerCrop"
            android:src="@drawable/userstory"
            app:shapeAppearanceOverlay="@style/NotificationPostImageShape"
            app:strokeColor="#5B255D"
            app:strokeWidth="1dp"
            tools:src="@drawable/userstory" />

        <!-- Middle: Full notification text -->
        <TextView
            android:id="@+id/notification"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:lineSpacingExtra="4dp"
            android:text="notification"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Sachin Rawat liked your photo. Tap to view the post and see more details about this activity." />

        <!-- Right: User who liked -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_notification_profile_ring"
            android:padding="3dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/notificationProfile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/userstory"
                app:shapeAppearanceOverlay="@style/CircleImageShape"
                tools:src="@drawable/userstory" />

        </FrameLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>