<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/linearViewPager"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginTop="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="#120819"
    app:cardCornerRadius="24dp"
    app:cardElevation="5dp"
    app:strokeColor="#4A2558"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_shimmer_post_card"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="14dp">

        <!-- Top Profile Section -->
        <LinearLayout
            android:id="@+id/linearLayout2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <View
                android:id="@+id/PostProfile"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_shimmer_circle" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <View
                    android:id="@+id/PostUserName"
                    android:layout_width="145dp"
                    android:layout_height="16dp"
                    android:background="@drawable/bg_shimmer_line_large" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:background="@drawable/bg_shimmer_circle_small" />

                    <View
                        android:id="@+id/PostSong"
                        android:layout_width="120dp"
                        android:layout_height="11dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_shimmer_line_small" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:id="@+id/ShowPostDate"
                android:layout_width="54dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_shimmer_date_chip" />

        </LinearLayout>

        <!-- Image Skeleton -->
        <FrameLayout
            android:id="@+id/PostImageSlider"
            android:layout_width="match_parent"
            android:layout_height="410dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_shimmer_image_box">

            <View
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:alpha="0.35"
                android:background="@drawable/bg_shimmer_center_icon" />

            <View
                android:id="@+id/stopMusic"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_shimmer_music_button" />

        </FrameLayout>

        <!-- Action Bar Skeleton -->
        <LinearLayout
            android:id="@+id/linearLayout3"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_shimmer_action_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <View
                android:id="@+id/PostLike"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_shimmer_circle_small" />

            <View
                android:id="@+id/Likes"
                android:layout_width="36dp"
                android:layout_height="12dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_shimmer_line_small" />

            <View
                android:id="@+id/PostComment"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/bg_shimmer_circle_small" />

            <View
                android:id="@+id/Comments"
                android:layout_width="28dp"
                android:layout_height="12dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_shimmer_line_small" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <View
                android:id="@+id/PostShare"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_shimmer_circle_small" />

            <View
                android:id="@+id/Share"
                android:layout_width="45dp"
                android:layout_height="12dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_shimmer_line_small" />

        </LinearLayout>

        <!-- Caption Skeleton -->
        <View
            android:id="@+id/PostCaption"
            android:layout_width="230dp"
            android:layout_height="13dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="13dp"
            android:background="@drawable/bg_shimmer_line_large" />

        <View
            android:layout_width="160dp"
            android:layout_height="11dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_shimmer_line_small" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>