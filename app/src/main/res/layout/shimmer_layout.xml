<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/linearViewPager"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal"
    android:weightSum="2">

    <!-- Product Skeleton 1 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        app:cardBackgroundColor="#1B1326"
        app:cardCornerRadius="22dp"
        app:cardElevation="5dp"
        app:strokeColor="#4A2558"
        app:strokeWidth="1dp">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/simmer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:shimmer_auto_start="true"
            app:shimmer_duration="1200">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_product_shimmer_card"
                android:orientation="vertical"
                android:padding="10dp">

                <FrameLayout
                    android:id="@+id/imageslider"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:background="@drawable/bg_product_shimmer_image">

                    <View
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_gravity="center"
                        android:alpha="0.35"
                        android:background="@drawable/bg_product_shimmer_circle" />

                </FrameLayout>

                <View
                    android:id="@+id/showProductName"
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_product_shimmer_line_large" />

                <View
                    android:layout_width="70dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_product_shimmer_line_small" />

                <View
                    android:id="@+id/showProductUnit"
                    android:layout_width="54dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_product_shimmer_chip" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/showProductPrice"
                        android:layout_width="58dp"
                        android:layout_height="16dp"
                        android:background="@drawable/bg_product_shimmer_line_large" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <View
                        android:id="@+id/showProductEdit"
                        android:layout_width="74dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_product_shimmer_button" />

                </LinearLayout>

            </LinearLayout>

        </com.facebook.shimmer.ShimmerFrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Product Skeleton 2 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        app:cardBackgroundColor="#1B1326"
        app:cardCornerRadius="22dp"
        app:cardElevation="5dp"
        app:strokeColor="#4A2558"
        app:strokeWidth="1dp">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/simmer2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:shimmer_auto_start="true"
            app:shimmer_duration="1200">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_product_shimmer_card"
                android:orientation="vertical"
                android:padding="10dp">

                <FrameLayout
                    android:id="@+id/imageslider1"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:background="@drawable/bg_product_shimmer_image">

                    <View
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_gravity="center"
                        android:alpha="0.35"
                        android:background="@drawable/bg_product_shimmer_circle" />

                </FrameLayout>

                <View
                    android:id="@+id/showProductName1"
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_product_shimmer_line_large" />

                <View
                    android:layout_width="82dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_product_shimmer_line_small" />

                <View
                    android:id="@+id/showProductUnit1"
                    android:layout_width="54dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_product_shimmer_chip" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/showProductPrice1"
                        android:layout_width="58dp"
                        android:layout_height="16dp"
                        android:background="@drawable/bg_product_shimmer_line_large" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <View
                        android:id="@+id/showProductEdit1"
                        android:layout_width="74dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_product_shimmer_button" />

                </LinearLayout>

            </LinearLayout>

        </com.facebook.shimmer.ShimmerFrameLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>