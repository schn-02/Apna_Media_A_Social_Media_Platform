<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BottomNavigationActiveIndicator">
        <item name="android:color">#1F4D9CFF</item>
        <item name="android:width">58dp</item>
        <item name="android:height">34dp</item>
        <item name="shapeAppearanceOverlay">@style/BottomNavigationActiveIndicatorShape</item>
    </style>

    <style name="BottomNavigationActiveIndicatorShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="CircleImageShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ViewProfilePostImageShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="NotificationPostImageShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="PostProfileImageShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="BottomNavTextActive">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="BottomNavTextInactive">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans</item>
    </style>


    <style name="BottomNavIndicatorShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>
</resources>